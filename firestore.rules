rules_version = '2';

// Reglas de la base Firestore de la Intranet (Instituto de Capacitación Legislativa).
//
// Modelo:
//  - authorized_users/{identificador}: roles y estados de acceso. Doc ID = EMAIL. La lista la lee Administración;
//    cada persona, solo su propia ficha.
//  - Colecciones de contenido: solo administradores escriben; aprobados leen.
//  - course_audits: el visitante puede escribir SOLO sus propios checks de cursada;
//    jamás puede homologar (aprobado_admin) ni tocar certifiedAt/adminNotes de otro.
//    Lectura: Administración todas; cada agente solo las propias.
//  - training_results: resultado anónimo de cada cursada terminada (sin datos personales),
//    legible por todos los aprobados para las cifras de Inicio.
//
// Desplegar con: firebase deploy --only firestore:rules
// o pegar el contenido en Firebase Console → Firestore Database → Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Helpers de identidad ─────────────────────────────────────────────── */

    // Google verificó el email de la cuenta.
    function emailVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function currentEmail() {
      return request.auth.token.email.lower();
    }

    // Admins maestros institucionales. DEBE coincidir con DEFAULT_MASTER_ADMIN_EMAILS
    // de lib/access-config.ts (y lo configurado en NEXT_PUBLIC_MASTER_ADMIN_EMAILS).
    function isMasterAdmin() {
      return emailVerified() && (
        currentEmail() == 'alexishinojosa1600@gmail.com' ||
        currentEmail() == 'instcapacitacionlegis@gmail.com'
      );
    }

    // Doc propio en authorized_users (por email).
    function ownUserDoc() {
      return get(/databases/$(database)/documents/authorized_users/$(currentEmail())).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/authorized_users/$(currentEmail()));
    }

    function isAdmin() {
      return isMasterAdmin() ||
        (emailVerified() && hasUserDoc()
          && ownUserDoc().role == 'administrador'
          && ownUserDoc().status == 'aprobado');
    }

    function isApprovedUser() {
      return isAdmin() ||
        (emailVerified() && hasUserDoc() && ownUserDoc().status == 'aprobado');
    }

    // Modo de aprobación compartido (meta/approval_mode): cuando el administrador
    // activa "auto_visitor", los registros nuevos aceptan su propio doc como aprobado.
    function autoVisitorModeOn() {
      return exists(/databases/$(database)/documents/meta/approval_mode)
        && get(/databases/$(database)/documents/meta/approval_mode).data.mode == 'auto_visitor';
    }

    /* ── Usuarios autorizados ─────────────────────────────────────────────── */

    match /authorized_users/{userEmail} {
      // Lectura: la lista completa (correos y nombres de todas las personas) es solo de Administración.
      // Cada persona puede leer ÚNICAMENTE su propia ficha (así el login sabe si está pendiente, aprobada o
      // rechazada). El cliente escucha la colección solo si es administrador (ensureUsersSync en lib/auth.ts).
      // ORDEN DE PUBLICACIÓN: esta línea va en el PASO 3, DESPUÉS de desplegar el código nuevo: el código viejo
      // hace que todo usuario aprobado escuche la colección completa y esa consulta quedaría rechazada.
      // En los pasos 1 y 2 la línea vigente es:  allow read: if request.auth != null;
      allow read: if isAdmin()
        || (emailVerified() && userEmail == currentEmail());

      // Auto-registro: cada usuario crea SOLO su propia ficha.
      //  - pendiente: comportamiento por defecto (espera aprobación del admin).
      //  - aprobado: solo si el modo compartido auto_visitor está activo.
      allow create: if isMasterAdmin()
        || (isAdmin() && request.resource.data.role != 'administrador')
        || (emailVerified()
            && userEmail == currentEmail()
            && request.resource.data.role == 'visitante'
            && request.resource.data.email == currentEmail()
            && (request.resource.data.status == 'pendiente'
                || (request.resource.data.status == 'aprobado' && autoVisitorModeOn())));

      // Actualización: admins. Solo un MAESTRO puede crear/promover administradores
      // o cambiar el status del doc de ADMINISTRADORES.
      function changesRole() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
      }
      allow update: if isMasterAdmin()
        || (isAdmin() && !changesRole())
        || (isAdmin()
            && changesRole()
            && resource.data.role != 'administrador'
            && request.resource.data.role != 'administrador'
            && request.resource.data.status in ['aprobado', 'pendiente', 'rechazado']);

      // Baja de usuarios: maestros o admins (no pueden borrar administradores).
      allow delete: if isMasterAdmin()
        || (isAdmin() && resource.data.role != 'administrador');
    }

    /* ── Contenido del instituto (escriben admins, leen aprobados) ────────── */

    function approvedOrAdminRead() {
      return isApprovedUser();
    }

    match /activities/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    match /news/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    match /programs/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    match /resources/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    match /links/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    match /team/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    match /institute_areas/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    // Configuración institucional (doc individual settings/app)
    match /settings/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    // Lista de recursos eliminados (doc individual meta/deleted_resources)
    match /meta/{docId} {
      allow read: if approvedOrAdminRead();
      allow write: if isAdmin();
    }

    /* ── Auditorías de cursada (anti-fraude) ──────────────────────────────── */

    function ownAudit() {
      return request.resource.data.agentEmail == currentEmail();
    }

    // `agentUid` (opcional) solo puede ser el uid de quien escribe: lo usa training_results para acreditar
    // que un resultado anónimo pertenece a su dueño.
    function agentUidIsOwn() {
      return !('agentUid' in request.resource.data)
        || request.resource.data.agentUid == request.auth.uid;
    }

    // Campos que un visitante puede alterar de su propia cursada.
    //  - 'aprobado_admin' y 'observado' son decisiones de Administración: el agente no las asigna ni las revierte,
    //    y una cursada en ese estado solo admite la reseña (una vez) y completar su uid.
    //  - La reseña (csatRating/csatComment/csatSubmittedAt) se deja una sola vez: no se puede cambiar después.
    // LÍMITE: estas reglas no pueden comprobar el ritmo de lectura; 'consistente' lo calcula el navegador.
    function visitorAuditChangeIsLegit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'checks',
        'completedModulesCount',
        'totalModules',
        'isFullyCompleted',
        'auditStatus',
        'auditVerdict',
        'firstCheckTimestamp',
        'lastCheckTimestamp',
        'timeDeltaMinutes',
        'csatRating',
        'csatComment',
        'csatSubmittedAt',
        'agentUid',
      ])
      && (resource.data.auditStatus in ['aprobado_admin', 'observado']
          ? request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['csatRating', 'csatComment', 'csatSubmittedAt', 'agentUid'])
          : request.resource.data.auditStatus in ['en_progreso', 'consistente', 'alerta_simultanea'])
      && (!('csatRating' in resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['csatRating', 'csatComment', 'csatSubmittedAt']));
    }

    match /course_audits/{docId} {
      // PRIVACIDAD: las cursadas llevan nombre, email y comentarios. Las lee Administración completas y cada
      // agente solo las propias (el cliente consulta con where agentEmail == su email). Las cifras que ven los
      // demás salen de training_results, que no tiene datos personales.
      // ORDEN DE PUBLICACIÓN: esta línea se publica en el PASO 3, DESPUÉS de desplegar el código nuevo (el código
      // viejo escucha toda la colección y esa consulta quedaría rechazada). En los pasos 1 y 2 la línea vigente es:
      //   allow read: if approvedOrAdminRead();
      allow read: if isAdmin()
        || (isApprovedUser() && resource.data.agentEmail == currentEmail());
      allow create: if isAdmin()
        || (isApprovedUser() && ownAudit() && agentUidIsOwn()
            && request.resource.data.auditStatus in ['en_progreso', 'consistente', 'alerta_simultanea']);
      allow update: if isAdmin()
        || (isApprovedUser() && ownAudit() && agentUidIsOwn() && visitorAuditChangeIsLegit());
      allow delete: if isAdmin();
    }

    /* ── Resultados anónimos de cursada (lo único que ven los demás) ──────── */

    // Un documento por cursada terminada (id = id de la cursada): sin nombre, email, área ni comentario.
    // Lo escribe el dueño de la cursada (personKey = su uid) o Administración; lo leen todos los aprobados.
    function resultShapeOk(auditId) {
      return request.resource.data.keys().hasOnly(['id', 'courseId', 'personKey', 'closedAt', 'csatRating', 'formado'])
        && request.resource.data.keys().hasAll(['id', 'courseId', 'personKey', 'closedAt', 'csatRating', 'formado'])
        && request.resource.data.id == auditId
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() <= 120
        && request.resource.data.personKey is string
        && request.resource.data.personKey.size() >= 1
        && request.resource.data.personKey.size() <= 128
        && request.resource.data.closedAt is number
        && request.resource.data.csatRating in ['Muy Satisfecho', 'Satisfecho', 'Neutral', 'Insatisfecho']
        && request.resource.data.formado is bool;
    }

    function ownResult(auditId) {
      return isApprovedUser()
        && request.resource.data.personKey == request.auth.uid
        && exists(/databases/$(database)/documents/course_audits/$(auditId))
        && get(/databases/$(database)/documents/course_audits/$(auditId)).data.agentEmail == currentEmail()
        // El resultado debe coincidir con la cursada real: mismo curso, misma reseña y cursada completa.
        && request.resource.data.courseId == get(/databases/$(database)/documents/course_audits/$(auditId)).data.courseId
        && request.resource.data.csatRating == get(/databases/$(database)/documents/course_audits/$(auditId)).data.csatRating
        && get(/databases/$(database)/documents/course_audits/$(auditId)).data.isFullyCompleted == true
        && (request.resource.data.formado == false
            || get(/databases/$(database)/documents/course_audits/$(auditId)).data.auditStatus
                 in ['consistente', 'aprobado_admin']);
    }

    match /training_results/{auditId} {
      allow read: if approvedOrAdminRead();
      allow create, update: if resultShapeOk(auditId) && (isAdmin() || ownResult(auditId));
      allow delete: if isAdmin()
        || (isApprovedUser() && resource.data.personKey == request.auth.uid);
    }

    /* ── Encuestas CSAT de visitas (creación anónima, una vez) ────────────── */

    match /visit_csat/{token} {
      // Lectura (resumen promedio en la ficha): solo usuarios aprobados o admins.
      allow read: if isApprovedUser();

      // Creación pública (sin login), una sola vez por token. El token DEBE coincidir
      // con el que el admin guardó en la actividad real (anti-spam: sin este ancla,
      // cualquiera podría sembrar respuestas falsas con tokens inventados).
      allow create: if token.matches('^csat-[a-z0-9-]{16,90}$')
        && !exists(/databases/$(database)/documents/visit_csat/$(token))
        && request.resource.data.keys().hasOnly(['activityId', 'rating', 'comment', 'submittedAt'])
        && request.resource.data.activityId is string
        && request.resource.data.activityId.size() >= 20
        && request.resource.data.activityId.size() <= 90
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.submittedAt is string
        && request.resource.data.submittedAt.size() <= 40
        && exists(/databases/$(database)/documents/activities/$(request.resource.data.activityId))
        && get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.csatSurveyToken == token;

      // Nadie puede modificar ni borrar respuestas ya enviadas (integridad del dato).
      allow update, delete: if false;
    }

    /* ── Todo lo demás: denegado ──────────────────────────────────────────── */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
