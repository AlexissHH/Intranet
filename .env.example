# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de la Intranet. Copiar a `.env.local` (local) o cargarlas
# en Vercel → Project → Settings → Environment Variables.
# NUNCA subir valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVIDOR (secretas: NO llevan el prefijo NEXT_PUBLIC_) ───────────────────

# Clave de la API de Gemini (asistente de IA). Solo se usa en el servidor.
# Recomendado: restringirla en Google Cloud y fijar una cuota/presupuesto diario.
GEMINI_API_KEY=""

# Quiénes pueden usar el asistente de IA además de los administradores y visitantes
# configurados más abajo. Todos deben ingresar con Google (email verificado).
#   AI_ALLOWED_EMAILS:  emails separados por coma.
#   AI_ALLOWED_DOMAINS: dominios completos separados por coma (ej. legislatura.gob.ar).
AI_ALLOWED_EMAILS=""
AI_ALLOWED_DOMAINS=""

# Límite de consultas al asistente por usuario (por instancia del servidor).
AI_RATE_LIMIT_MAX="20"
AI_RATE_LIMIT_WINDOW_MIN="10"

# Política de seguridad de contenido (CSP). Vacío = "solo reporte" (no bloquea nada,
# ideal para probar en una vista previa). Poner "enforce" cuando la consola del
# navegador no muestre violaciones en login, PDF y vista de .docx.
CSP_MODE=""

# ── CLIENTE (públicas: quedan visibles en el navegador, no poner secretos) ───

# Configuración de Firebase. Si se dejan vacías, la app usa firebase-applet-config.json.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=""

# Administradores adicionales (emails separados por coma). Los administradores por
# defecto (alexishinojosa1600@gmail.com e instcapacitacionlegis@gmail.com) están definidos
# en lib/access-config.ts. Un administrador solo es válido si
# ingresa con Google: escribir su email a mano NO alcanza.
NEXT_PUBLIC_MASTER_ADMIN_EMAILS=""

# Asistente de IA (Gemini): "true" para mostrar el asistente en la intranet. Requiere también
# GEMINI_API_KEY (secreta) y, para usuarios que no son administradores, AI_ALLOWED_EMAILS / AI_ALLOWED_DOMAINS.
NEXT_PUBLIC_AI_ASSISTANT_ENABLED="false"

# Visitantes de solo lectura, siempre aprobados (emails separados por coma).
NEXT_PUBLIC_ALLOWED_VISITOR_EMAILS=""
